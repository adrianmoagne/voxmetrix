{
	"name": "voxmetrix",
	"version": "0.1.0",
	"private": true,
	"license": "CC-BY-NC-SA-4.0",
	"description": "Open-source monorepo for the VoxMetrix experiment platform.",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm-run-all --parallel dev:*",
		"dev:web": "npm run dev -w @voxmetrix/web",
		"dev:server": "npm run dev -w @voxmetrix/server",
		"build": "npm run build -w @voxmetrix/server && npm run build -w @voxmetrix/web",
		"lint": "npm run lint -w @voxmetrix/web",
		"test": "npm run test -w @voxmetrix/server"
	},
	"devDependencies": {
		"npm-run-all": "^4.1.5"
	}
}
