		"jest": "^29.7.0",
		"mongodb-memory-server": "^10.1.2",
		"nodemon": "^3.1.10",
		"supertest": "^7.1.1",
		"ts-jest": "^29.4.0",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"tsc-alias": "^1.8.10",
