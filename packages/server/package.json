	},
	"homepage": "https://github.com/voxmetric/voxmetric#readme",
	"dependencies": {
		"bcrypt": "^6.0.0",
		"body-parser": "^2.2.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^16.5.0",
		"express": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.15.1",
		"multer": "^2.0.2",
		"resend": "^6.6.0"
