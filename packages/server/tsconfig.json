{
	"compilerOptions": {
		"target": "es2016",
		"module": "commonjs",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"baseUrl": "./src",
		"experimentalDecorators": true,
		"paths": {
			"@api/*": ["api/*"],
			"@core/*": ["core/*"],
			"@config/*": ["config/*"],
			"@utils/*": ["utils/*"],
			"@modules/*": ["modules/*"],
			"@modules": ["modules/index.ts"],
			"@types/*": ["@types/*"],
			"@decorators/*": ["decorators/*"],
			"@middlewares/*": ["middlewares/*"],
			"src/*": ["*"]
		}
	},
	"include": ["./src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
